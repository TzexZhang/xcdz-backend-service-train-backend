<?xml version="1.0" encoding="UTF-8"?>
<!--
  软件单元:JAVA-MAPPER-TRACK-XML-001
  功能:批次数据联表查询 SQL（track LEFT JOIN target 组合目标名称）
  设计说明:
    1. JOIN 查询超出 LambdaQueryWrapper 能力范围（Wrapper 仅支持单表），
       按项目约定回归 XML 方式，SQL 与动态条件在此集中维护；
    2. 统一 LEFT JOIN 而非 INNER JOIN:track 行数语义必须与单表查询一致——
       推送水位去重与 REST 对账都依赖"查到多少条 track"，目标行缺失仅
       导致 targetName 为 null，不可丢 track 行；
    3. 结果映射依赖 map-underscore-to-camel-case（application.yml 已开启），
       列名 target_name → targetName 自动映射，无需 resultMap
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xcdz.service.mapper.TrackMapper">

    <!-- 联表公共列清单:track 全列 + 组合的 target_name -->
    <sql id="baseColumns">
        t.id, t.target_id, tg.target_name, t.metric_value, t.collect_time, t.create_time
    </sql>

    <!-- 条件查询（订阅 INIT 快照与 REST 对账共用）:过滤语义与 WebSocket 订阅一致，
         目标名称模糊关键字（空白=全部目标）、时间为空=不限制；LIMIT 用占位符预编译 -->
    <select id="selectByCondition" resultType="com.xcdz.service.dto.TrackDetailDTO">
        SELECT <include refid="baseColumns"/>
        FROM track t
        LEFT JOIN target tg ON tg.id = t.target_id
        <where>
            <if test="target != null and target != ''">
                AND tg.target_name LIKE CONCAT('%', #{target}, '%')
            </if>
            <if test="startTime != null">AND t.collect_time &gt;= #{startTime}</if>
            <if test="endTime != null">AND t.collect_time &lt;= #{endTime}</if>
        </where>
        ORDER BY t.id ASC
        LIMIT #{limit}
    </select>

    <!-- 水位增量查询:查出所有 id 大于指定水位的记录（推送侧感知"第三方新入库数据"的核心），
         依赖 track.id 自增主键的单调性；同一行不会被重复扫描（水位只增不减） -->
    <select id="selectIncremental" resultType="com.xcdz.service.dto.TrackDetailDTO">
        SELECT <include refid="baseColumns"/>
        FROM track t
        LEFT JOIN target tg ON tg.id = t.target_id
        WHERE t.id &gt; #{afterId}
        ORDER BY t.id ASC
        LIMIT #{limit}
    </select>
</mapper>
